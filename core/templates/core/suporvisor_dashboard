{% extends 'core/base.html' %}
{% block content %}
<div class="appbar"><b>👷‍♂️ Supervisor Dashboard</b><a href__="{% url 'map' %}" class="btn btn-out">Map</a></div>
<div class="wrap" style="padding:30px 24px">
  <div class="grid grid-3" style="margin-bottom:30px">
    <div class="card"><div style="color:var(--muted);font-size:12px;text-transform:uppercase">Unresolved</div><div style="font-size:34px;font-weight:900">{{ unresolved }}</div></div>
    <div class="card"><div style="color:var(--muted);font-size:12px;text-transform:uppercase">High-risk</div><div style="font-size:34px;font-weight:900;color:var(--red)">{{ high }}</div></div>
    <div class="card"><div style="color:var(--muted);font-size:12px;text-transform:uppercase">Resolved today</div><div style="font-size:34px;font-weight:900;color:#69f0ae">{{ resolved_today }}</div></div>
  </div>
  <div class="card" style="padding:0;overflow:hidden">
    <table><tr><th>#</th><th>Type</th><th>Priority</th><th>Reporter</th><th>When</th><th></th></tr>
    {% for h in hazards %}
      <tr><td>{{ h.id }}</td><td>{{ h.get_hazard_type_display }}</td><td><span class="pill {{ h.priority }}">{{ h.get_priority_display }}</span></td>
      <td>{{ h.reported_by|default:"—" }}</td><td>{{ h.reported_at|date:"d M H:i" }}</td>
      <td><a href__="{% url 'resolve_hazard' h.id %}" class="btn btn-red" style="padding:6px 12px">Review →</a></td></tr>
    {% empty %}<tr><td colspan="6" style="color:var(--muted)">No open hazards 🎉</td></tr>{% endfor %}
    </table>
  </div>
</div>
{% endblock %}