

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VikelaMine — Settings</title>
<style>
:root{
  /* changed to match your cover slide */
  --red:#e72828; /* orange from your T logo, not bright red */
  --bg:#1A1F26; /* charcoal from cover, not pure black */
  --panel:#232A34; /* lighter charcoal for cards */
  --panel2:#2A323D;
  --line:#2E353F;
  --muted:#9AA0A8;
  --beige:#B8A082; /* top tag color from slide */
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:#fff;font-family:ui-sans-serif,system-ui,sans-serif}
a{color:inherit;text-decoration:none}
.nav{display:flex;align-items:center;gap:28px;padding:18px 40px;border-bottom:1px solid var(--line);background:#1A1F26;position:sticky;top:0;z-index:50}
.logo{font-weight:800;font-size:22px;letter-spacing:-.5px}
.logo b{color:#e72828}
.nav a.link{color:#d4d4d4;font-size:14px;cursor:pointer}
.nav a.link:hover{color:#fff}
.nav a.link.active{color:#fff}
.nav .spacer{flex:1}
.nav .btn-out{font-family:inherit;flex-shrink:0}
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:8px;font-weight:600;font-size:14px;cursor:pointer;border:none}
.btn-red{background:var(--red);color:#fff}.btn-out{background:transparent;border:1px solid #3A444F;color:#fff}
.btn-ghost{background:#2A323D;color:#fff}
.wrap{max-width:1100px;margin:0 auto;padding:0 24px}
 
.metrics{display:flex;justify-content:center;gap:60px;padding:32px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);flex-wrap:wrap;background:#1E252F}
.metrics div{text-align:center}
.metrics .n{font-size:40px;font-weight:900}
.metrics .l{color:var(--muted);font-size:12px;letter-spacing:1px;text-transform:uppercase}
.section{padding:40px 0;background:#1A1F26}
.section h2{font-size:26px;font-weight:900;letter-spacing:-1px;margin:0 0 8px}
.section .lead{color:var(--muted);max-width:620px;margin-bottom:26px}
.grid{display:grid;gap:20px}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-2{grid-template-columns:repeat(2,1fr)}
@media(max-width:760px){.grid-3,.grid-2{grid-template-columns:1fr}.nav{gap:14px;padding:14px 18px;overflow-x:auto}.nav a.link{flex-shrink:0}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px}
.card .ic{width:40px;height:40px;border-radius:10px;background:rgba(231,111,40,.15);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:14px}
.card h3{margin:0 0 6px;font-size:18px}.card p{color:var(--muted);font-size:14px;line-height:1.5;margin:0}
footer{border-top:1px solid var(--line);padding:40px;color:var(--muted);font-size:13px;text-align:center;background:#151A21}
 
/* app pages */
.appbar{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid var(--line);background:#1A1F26}
.pill{padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase}
.pill.reported{background:#3b1d1d;color:#ff8a80}.pill.investigating{background:#3b2a0e;color:#ffca28}
.pill.in_progress{background:#0e2a3b;color:#42a5f5}.pill.resolved{background:#0e3b1f;color:#69f0ae}
.pill.high{background:#3b1d1d;color:#ff8a80}.pill.medium{background:#3b2a0e;color:#ffca28}.pill.low{background:#0e3b1f;color:#69f0ae}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);font-size:14px}
th{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.5px}
input,select,textarea{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:11px;color:#fff;font-size:14px}
label{font-size:13px;color:var(--muted);margin:14px 0 6px;display:block}
/* panic button */
.panic-fab{position:fixed;right:20px;bottom:20px;width:84px;height:84px;border-radius:50%;background:var(--red);color:#fff;border:none;font-weight:800;font-size:14px;box-shadow:0 0 0 0 rgba(231,111,40,.7);animation:pulse 1.6s infinite;cursor:pointer;z-index:100}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(231,111,40,.6)}70%{box-shadow:0 0 0 22px rgba(231,111,40,0)}100%{box-shadow:0 0 0 0 rgba(231,111,40,0)}}
.panic-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;z-index:200}
.panic-box{background:var(--panel);border:1px solid var(--red);border-radius:16px;padding:30px;max-width:420px;text-align:center}
 
/* --- admin-page additions (not in the brand sheet, kept in the same visual language) --- */
.appwrap{max-width:1180px;margin:0 auto;padding:26px 24px 60px}
.pagehead{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:10px;margin-bottom:22px}
.pagehead h1{font-size:24px;font-weight:800;margin:0}
.pagehead .hint{color:var(--muted);font-size:13px}
.card-row{margin-bottom:22px}
.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px}
.card-head h2{margin:0;font-size:16px}
.chips{display:flex;gap:8px;margin-bottom:16px}
.chip{background:var(--panel2);border:1px solid var(--line);color:var(--muted);padding:6px 14px;border-radius:999px;font-size:13px;cursor:pointer}
.chip.active{background:var(--red);color:#fff;border-color:var(--red)}
.btn-sm{padding:6px 12px;font-size:13px}
.btn-danger{background:#3b1d1d;color:#ff8a80}
select.field,input.field{width:100%;margin-top:2px}
.settings-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}
.settings-row:last-child{border-bottom:none}
.settings-row input[type=number]{width:80px;text-align:center}
 
/* login (home page only) */
#login-screen{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:300;padding:20px}
.login-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:36px 32px;width:100%;max-width:360px}
.login-card label{margin:12px 0 6px}
.login-card input{width:100%}
.login-error{color:#ff8a80;font-size:13px;margin:10px 0 0;display:none}
body.logged-in #login-screen{display:none}
body:not(.logged-in) #app{display:none}
</style>
</head>
