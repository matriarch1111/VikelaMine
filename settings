    </nav>
 
  <div class="appwrap">
    <!-- SYSTEM SETTINGS & AUDIT LOG PAGE -->
    <section id="settings">
      <div class="pagehead"><h1>System settings &amp; audit log</h1></div>
      <div class="grid grid-2">
        <div class="card">
          <div class="card-head"><h2>System settings</h2></div>
          <div class="settings-row"><span>Worker-view purge window</span><input type="number" value="30"> days</div>
          <div class="settings-row"><span>Default alert radius</span><input type="number" value="50"> meters</div>
          <div class="settings-row"><span>AI provider fallback</span><span class="pill resolved">Enabled</span></div>
        </div>
        <div class="card">
